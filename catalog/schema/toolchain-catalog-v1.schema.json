{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wosler-Corp/sonosystem-toolchain/catalog/schema/toolchain-catalog-v1.schema.json",
  "title": "SonoSystem Windows Toolchain Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "platform",
    "architecture",
    "packages",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "platform": {
      "const": "windows"
    },
    "architecture": {
      "const": "x86_64"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "profiles": {
      "type": "object",
      "required": [
        "ci-windows",
        "dev-windows"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "properties": {
        "ci-windows": {
          "$ref": "#/$defs/profile"
        },
        "dev-windows": {
          "$ref": "#/$defs/profile"
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^[A-Za-z]:)|(^[\\\\/])|((^|[\\\\/])\\.\\.([\\\\/]|$))"
      }
    },
    "profile": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "release",
        "upstream",
        "licenses",
        "dependencies",
        "install",
        "validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "upstream": {
          "$ref": "#/$defs/upstream"
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/safeRelativePath"
              },
              {
                "pattern": "^licenses[\\\\/]"
              }
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/probe"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "asset",
        "sha256",
        "sizeBytes",
        "attestation"
      ],
      "properties": {
        "repository": {
          "const": "Wosler-Corp/sonosystem-toolchain"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^[Ll][Aa][Tt][Ee][Ss][Tt]$"
          }
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\/]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "attestation": {
          "const": "github-immutable-release"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "version",
        "retrievedAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipeVersion",
        "kind",
        "target",
        "destination",
        "expandedSizeBytes"
      ],
      "properties": {
        "recipeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "zip",
            "msi",
            "exe",
            "driver"
          ]
        },
        "target": {
          "enum": [
            "toolchain-root",
            "msys2-root",
            "vcpkg-root",
            "windows-driver-store"
          ]
        },
        "destination": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "expandedSizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "enum": [
            "file-exists",
            "file-version",
            "command-version",
            "sha256",
            "authenticode-valid",
            "inf-provider-version"
          ]
        },
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "expected": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
